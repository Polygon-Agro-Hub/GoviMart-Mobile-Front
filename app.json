{
  "expo": {
    "name": "Govi Mart",
    "slug": "govi-mart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/public/app-icon-android.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.polygonagro.Polygon",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/public/app-icon-android.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CALL_PHONE"
      ]
    },
    "ios": {
      "icon": "./src/assets/images/public/app-icon-android.png",
      "bundleIdentifier": "com.polygonagro.Polygon",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is required to scan documents and capture images.",
        "NSMicrophoneUsageDescription": "Microphone access is required for in-app communication.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required to upload mart-related images.",
        "NSLocationWhenInUseUsageDescription": "Location access is required to track mart activity.",
        "NSUserTrackingUsageDescription": "Tracking is used to improve app experience.",
        "NSUserNotificationUsageDescription": "Notifications are used to send important mart updates.",
        "NSPhoneUsageDescription": "Phone access is used to call drivers or customers directly."
      }
    },
    "web": {
      "favicon": "./src/assets/images/public/app-icon-android.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/public/polygon-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ed205ef8-ce38-4be4-a1e0-08ba15085639"
      }
    }
  }
}
