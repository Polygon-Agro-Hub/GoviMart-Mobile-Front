{
  "expo": {
    "name": "Polygon",
    "slug": "Polygon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/public/app-icon-android.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.polygonagro.Polygon",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/public/app-icon-android.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.CALL_PHONE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.WAKE_LOCK",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.CHANGE_NETWORK_STATE"
      ]
    },
    "ios": {
      "icon": "./src/assets/images/public/app-icon-ios.png",
      "bundleIdentifier": "com.polygonagro.Polygon",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Camera access is required to take profile photos and capture images.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required to upload profile and complaint images.",
        "NSPhotoLibraryAddUsageDescription": "Photo library access is required to save related images.",
        "NSLocationWhenInUseUsageDescription": "Location access is required to detect and set delivery addresses."
      }
    },
    "web": {
      "favicon": "./src/assets/images/public/app-icon-android.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-keep class expo.** { *; }"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/public/polygon-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Photo library access is required to upload related images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": false
        }
      ],
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/public/polygon-notification-icon.png",
          "color": "#FF8A00",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/withCustomAndroidPermissions"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
